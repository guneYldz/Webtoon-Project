# Asıl dosya: docker-compose.yml ile AYNI klasördeki .env
#   ~/webtoon/.env
#
# Backend/.env varsa eski bot scriptleri onu da okur; aynı anahtar
# her iki yerde varsa KÖKTEKİ değer kullanılır.
#
# .env.example şablon. Kopyala: cp .env.example .env
# Gerçek şifreleri sadece .env içine yaz. GitHub'a gitmez.

POSTGRES_PASSWORD=degistir
DB_CONNECTION=postgresql://webtoon_admin:degistir@db:5432/webtoon_db
BOT_DB_CONNECTION=postgresql://webtoon_admin:degistir@localhost:5433/webtoon_db
SECRET_KEY=uzun-rastgele-bir-anahtar-yaz

NEXT_PUBLIC_API_URL=https://kaosmanga.net/api
NEXT_PUBLIC_SITE_URL=https://kaosmanga.net

# ── Google OAuth Girişi ──────────────────────────────────────────────────────
# Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── E-posta Servisi (Şifre Sıfırlama) ─────────────────────────────────────────
# 1. Öncelikli Yöntem: Resend HTTP API (https://resend.com/api-keys)
RESEND_API_KEY=

# 2. Alternatif / Yedek Yöntem: SMTP (STARTTLS / SSL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 465 portu veya SSL için true:
SMTP_USE_SSL=false
# Gönderen adresi
MAIL_FROM=Kaos Manga <noreply@kaosmanga.net>
# Yerel geliştirme ortamında doğrulama kodunu terminale yazdırmak için:
# MAIL_DEBUG_LOG=true

# pgAdmin giriş bilgisi. docker-compose.yml'e yazma (GitHub'a gider).
# Bu iki satır YALNIZCA pgAdmin ilk kez açılırken işlenir.
# Sonra değiştirmek için .env'i güncelle + pgadmin_data volume'unu sil.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=degistir

BOT_USERNAME=
BOT_PASSWORD=

# ── Manga Bot (botoon.py) — Yerel PC'den sunucuya bağlantı ─────────────────
# Bot senin PC'inde çalışır, çevirir, sonra sunucuya yükler
# Sunucu API adresi (varsayılan: https://kaosmanga.net/api)
BOT_API_URL=https://kaosmanga.net/api
# Bot sunucuda çalışıyorsa BOT_API_URL'yi boş bırak, BOT_DB_CONNECTION kullanılır

GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
GOOGLE_API_KEY_6=
GOOGLE_API_KEY_7=

# Manga Çeviri Pipeline (botoon.py — Asura Scans)
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenRouter (opsiyonel yedek): https://openrouter.ai/keys
OPENROUTER_API_KEY=
