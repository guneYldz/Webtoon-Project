# Asıl dosya: docker-compose.yml ile AYNI klasördeki .env
#   ~/webtoon/.env
#
# Backend/.env varsa eski bot scriptleri onu da okur; aynı anahtar
# her iki yerde varsa KÖKTEKİ değer kullanılır.
#
# .env.example şablon. Kopyala: cp .env.example .env
# Gerçek şifreleri sadece .env içine yaz. GitHub'a gitmez.

POSTGRES_PASSWORD=degistir
DB_CONNECTION=postgresql://webtoon_admin:degistir@db:5432/webtoon_db
BOT_DB_CONNECTION=postgresql://webtoon_admin:degistir@localhost:5433/webtoon_db
SECRET_KEY=uzun-rastgele-bir-anahtar-yaz

NEXT_PUBLIC_API_URL=https://kaosmanga.net/api
NEXT_PUBLIC_SITE_URL=https://kaosmanga.net

# pgAdmin giriş bilgisi. docker-compose.yml'e yazma (GitHub'a gider).
# Bu iki satır YALNIZCA pgAdmin ilk kez açılırken işlenir.
# Sonra değiştirmek için .env'i güncelle + pgadmin_data volume'unu sil.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=degistir

BOT_USERNAME=
BOT_PASSWORD=

# DeepSeek — roman çevirisi ve manga overlay (GitHub'a yazma)
DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY_2=

